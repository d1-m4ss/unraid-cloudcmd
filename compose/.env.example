CLOUDCMD_ROOT=/mnt/fs
CLOUDCMD_TERMINAL=false
CLOUDCMD_CONSOLE=true
CLOUDCMD_OPEN=false
CLOUDCMD_NAME=Unraid Cloud Commander
CLOUDCMD_ONE_FILE_PANEL=false
CLOUDCMD_CONFIRM_COPY=true
CLOUDCMD_CONFIRM_MOVE=true
HOME=/config
# Логин и пароль не задавайте здесь: их вводят в настройках Cloud Commander (F10).
# Переменная CLOUDCMD_AUTH в этом файле перекрывает сохранённый конфиг.
