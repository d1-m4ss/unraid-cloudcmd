# Time zone of the container (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=UTC
CLOUDCMD_ROOT=/mnt/fs
CLOUDCMD_TERMINAL=false
CLOUDCMD_CONSOLE=true
CLOUDCMD_OPEN=false
CLOUDCMD_NAME=Unraid Cloud Commander
CLOUDCMD_ONE_FILE_PANEL=false
CLOUDCMD_CONFIRM_COPY=true
CLOUDCMD_CONFIRM_MOVE=true
HOME=/config
# Do not set the login and password here: enter them in the Cloud Commander settings (F10).
# A CLOUDCMD_AUTH variable in this file overrides the saved configuration.
